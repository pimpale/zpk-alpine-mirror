server {
    listen ${PORT};
    listen [::]:${PORT};

    root /srv/alpine;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ =404;
        autoindex on;
        expires 1h;
        add_header Cache-Control "public";
    }
}