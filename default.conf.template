server {
    listen ${PORT};
    listen [::]:${PORT};

    root /srv/alpine;

    autoindex on;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri =404;
        expires 1h;
        add_header Cache-Control "public";
    }
}